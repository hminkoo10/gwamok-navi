# 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 올리지 않는다.

# AI: OpenAI 호환 Chat Completions 주소 (끝에 /chat/completions는 붙이지 않는다)
# 관리 화면의 AI 연결에서 다른 연결(Claude API, Gemini API 등)을 고르면 아래 AI_* 값 대신 그걸 쓴다
AI_BASE_URL=https://example.com/v1
AI_API_KEY=
AI_MODEL=
# 편제표 사진·PDF를 읽을 모델. 비우면 AI_MODEL을 쓴다 (이미지 입력을 지원해야 함)
AI_VISION_MODEL=
# max_tokens 대신 max_completion_tokens만 받는 모델이면 주석을 푼다
# AI_MAX_TOKENS_PARAM=max_completion_tokens
# 공급자가 response_format=json_object를 지원하면 1
# AI_JSON_MODE=1
# 추론(생각) 강도. 모델마다 받는 값이 다르다 (예: Claude·GLM은 low, GPT·Qwen은 none). 비우면 보내지 않는다
# AI_REASONING_EFFORT=
# AI_VISION_REASONING_EFFORT=

# 관리 화면(AI 연결)에서 넣은 API 키를 암호화하는 비밀값 (16자 이상 아무 문자열).
# 비우면 DATA_DIR/ai-key.secret 파일을 만들어 쓴다. 운영 서버에서는 DB와 떨어진 여기에 두는 편이 안전하다.
# 바꾸면 저장해 둔 키를 풀 수 없으니 관리 화면에서 키를 다시 넣는다
# AI_KEY_SECRET=

# 하루 전체 호출 상한의 처음 값 (기본: 문장 검색 3000회, 파일 올려 읽기 300회, 학교 편제표 자동 읽기 200회).
# 서버를 켠 뒤에는 관리 화면의 설정에서 바꾼다
# DAILY_LIMIT_MATCH=3000
# DAILY_LIMIT_IMPORT=300
# DAILY_LIMIT_READ=200
# 대학 원문이 바뀌었을 때 AI로 바뀐 곳을 찾는 하루 횟수
# DAILY_LIMIT_DATA=30

# 자동으로 읽은 학교 편제표를 모아 두는 곳 (SQLite 파일 gwamok.db가 생긴다)
DATA_DIR=./data

# 로그인은 Google 계정으로만 한다. Google 클라우드 콘솔 > API 및 서비스 > 사용자 인증 정보에서
# 'OAuth 클라이언트 ID'(웹 애플리케이션)를 만들고, 승인된 리디렉션 URI에 아래 주소를 넣는다
#   운영: https://<주소>/api/auth/google/callback   개발: http://localhost:5174/api/auth/google/callback
# OAuth 동의 화면은 '외부', 범위는 openid·email만 쓴다 (민감하지 않은 범위라 앱 확인 없이 게시할 수 있다)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 운영 주소 (Google에서 돌아올 주소를 만든다). 비우면 요청이 들어온 주소를 쓴다
# PUBLIC_URL=https://example.com

# 대표 관리자 Google 계정 이메일. 이 계정으로 로그인하면 대표 관리자가 되고,
# 관리 화면 > 사용자에서 다른 사람을 관리자로 지정·취소할 수 있다 (지정된 관리자는 관리자를 줄 수 없다)
OWNER_EMAIL=

# 스크립트용: 잘못 읽힌 편제표를 숨길 때 쓰는 토큰 (16자 이상). 비우면 이 API가 꺼진다. 관리 화면은 관리자 로그인을 쓴다
# POST /api/admin/hide  Authorization: Bearer <토큰>  {"id": 번호}
ADMIN_TOKEN=

# 나이스 교육정보 개방 포털 인증키. 없으면 학교 검색 결과가 5건까지만 나온다
NEIS_API_KEY=

# 운영 서버
PORT=8080
HOST=127.0.0.1
# nginx 같은 프록시 뒤에 둘 때만 1 (X-Forwarded-For·X-Forwarded-Proto를 믿는다).
# 이때 nginx에 proxy_set_header X-Forwarded-Proto $scheme; 를 넣어야 로그인 쿠키에 Secure가 붙는다
TRUST_PROXY=0
# 프록시가 X-Forwarded-Proto를 넘기지 않는데 HTTPS로만 서비스하면 1 (로그인 쿠키에 Secure)
# COOKIE_SECURE=1
# 다른 주소에서 API를 부르게 할 때만 (쉼표로 구분)
# ALLOWED_ORIGINS=https://example.com
